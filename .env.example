# Copy to .env and fill in. .env is in .gitignore and never reaches the logs.
# install.sh makes this copy itself and fills in some of the values.

# --- video source ---
# Both URLs point at go2rtc, not directly at the camera: go2rtc holds a single
# connection to the camera and serves it to any number of consumers.
PAWSIGHT_RTSP=rtsp://127.0.0.1:8554/dog_cam
# The detector can watch a separate lower-resolution stream.
# On Xiaomi cameras that is ?subtype=sd, and it matters: at 2K over P2P the receive
# buffer chokes (551 overflows/min, gaps every ~8 s); at SD there are none.
# A regular RTSP camera has no separate substream: leave dog_cam.
PAWSIGHT_DETECT_RTSP=rtsp://127.0.0.1:8554/dog_cam

# --- where the broker and the "brain" live ---
# native — mosquitto from Homebrew + the brain in .venv. No Docker needed at all.
# docker — both in containers (docker-compose.yml).
PAWSIGHT_STACK=native

# --- PTZ: Xiaomi pan/tilt cameras only ---
# NOTE: this is the DEVICE token (32 hex), not the one go2rtc stores.
# Get it with scripts/get_device_token.py; it does not ask for a password.
# For a regular RTSP camera leave it empty and keep the three keys below at 0.
# Example address: CAMERA_IP=192.168.1.50
CAMERA_IP=
CAMERA_TOKEN=

# Pan/tilt features. For a fixed camera set all to zero, otherwise the detector
# will wait in vain for a PTZ that does not exist.
PAWSIGHT_TILT_HOLD=0
PAWSIGHT_FOLLOW_DOG=0
PAWSIGHT_SEARCH_SEC=0

# --- Patrol: home on the bowls and searching for the dog by sectors ---
# By default the camera points at the bowls. If the dog has been out of frame
# longer than PAWSIGHT_SEARCH_IDLE_SEC, a sweep runs: sector right, home, sector
# left, home, and after the same timeout the cycle repeats. Dog appears: follow.
# 0 brings back the old search (one step every PAWSIGHT_SEARCH_SEC).
PAWSIGHT_HOME_HOLD=1
PAWSIGHT_SEARCH_IDLE_SEC=180

# A sector is set in motor PULSES, not degrees: the camera's field of view was
# never measured, and "30°" would be a made-up number. The step is asymmetric in
# hardware: a pulse to the right moves the frame by 9.6% of its width, to the left
# by 16.1%, hence different steps: this way both sides sweep roughly the same angle
# (≈1.2 frame widths over 4 stops). Tune it by eye on the dashboard.
PAWSIGHT_SCAN_STEP_RIGHT=3
PAWSIGHT_SCAN_STEP_LEFT=2
PAWSIGHT_SCAN_STEPS=4
PAWSIGHT_SCAN_DWELL_SEC=5
# A stop waits not only for the clock but also for live frames: after a pan the
# stream freezes for 6-19 s, and the sector would be swept blind.
PAWSIGHT_SCAN_DWELL_FRAMES=2
# Safety limit: the motor will not make more pulses than this in one sweep.
PAWSIGHT_SCAN_MAX_PULSES=60

# Pause after the dog disappears before the patrol takes the camera over from
# following. Zero is dangerous here: with flickering detection, following pulls the
# camera after the "dog" while the patrol pulls it home, and the motor runs back and
# forth for nothing (in production that came to 554 pans in 40 minutes).
PAWSIGHT_PATROL_RELEASE_SEC=10

# Tracker. After losing a track, the stock botsort.yaml does not start a new one on
# a dog with conf < 0.30 (IoU·conf confirmation). The profile without fuse_score is
# an experiment, untested in production: enable it only while watching the track-loss
# log (docs/architecture.md, 2026-09-07).
# PAWSIGHT_TRACKER=trackers/botsort-dog.yaml

# --- dashboard and setup page ---
# Loopback only: the setup page is where the camera password and the bot token
# are entered. In docker mode the address is overridden to 0.0.0.0 in
# docker-compose.yml; nothing gets out from there anyway, the port is published
# as 127.0.0.1:8099.
PAWSIGHT_WEB_HOST=127.0.0.1
PAWSIGHT_WEB_PORT=8099

# --- Telegram ---
# Create the bot with @BotFather; get your chat_id from @userinfobot.
# Empty: events just pile up in the database, with no notifications.
# There can be several recipients, comma-separated:
#   TELEGRAM_CHAT_ID=11111111,22222222
# EVERY recipient must press Start in the bot themselves: Telegram does not let
# a bot write first, and sending to them fails with "chat not found".
#
# The same list is the list of users ALLOWED to use bot commands (/snap sends a
# frame from the camera right now). The bot ignores everyone else; while the list
# is empty, commands work for nobody.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- VLM ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct

# --- detector behaviour ---
# auto = Apple Metal (mps), else an NVIDIA GPU (cuda:0), else cpu
PAWSIGHT_DEVICE=auto
PAWSIGHT_MODEL=yolo26s.pt
PAWSIGHT_DETECT_FPS=5
PAWSIGHT_IMGSZ=640
# Downscaling the frame before inference: a smaller frame is faster at the same
# detection confidence (measured). The values below are tuned for a 640x360 source.
PAWSIGHT_INFER_W=640
PAWSIGHT_INFER_H=360
# The threshold is low ON PURPOSE: BoT-SORT has two stages, and the second keeps an
# already tracked dog when its confidence drops (being held, wearing a cone, backlit).
PAWSIGHT_CONF=0.15
PAWSIGHT_TRACKER=botsort.yaml
PAWSIGHT_RATE_LIMIT_SEC=300

# --- data collection for fine-tuning ---
# Frames for fine-tuning on YOUR dog. See docs/FINETUNE.md
PAWSIGHT_COLLECT_DATASET=1

# --- dashboard: logs, fine-tuning, cleanup ---
# how many log lines the brain keeps in memory for the "Logs" tab
PAWSIGHT_LOG_BUFFER=3000
# 0 removes the fine-tuning start button from the dashboard
PAWSIGHT_TRAIN_FROM_DASHBOARD=1
PAWSIGHT_TRAIN_EPOCHS=80
PAWSIGHT_TRAIN_IMGSZ=960
PAWSIGHT_TRAIN_BATCH=16
# cleanup: what counts as "old" and how many training runs to keep
PAWSIGHT_CLEAN_DAYS=14
PAWSIGHT_CLEAN_KEEP_RUNS=1

# --- go2rtc: API and WebUI login ---
# Needed only by the brain in docker mode: go2rtc.yaml is not mounted into the container.
# Natively, the dashboard and start.sh read the login straight from go2rtc.yaml (api section).
# install.sh fills in both on first install, with the same values.
# Empty: go2rtc without a password (how older installs work).
GO2RTC_USER=
GO2RTC_PASS=

# --- MQTT broker: login ---
# Empty: the broker is anonymous (how installs from before passwords work). A new
# install gets both values from install.sh together with mosquitto/passwd;
# an existing one is migrated with `.venv/bin/python -m pawsight.authsetup --mqtt`.
PAWSIGHT_MQTT_USER=
PAWSIGHT_MQTT_PASS=
